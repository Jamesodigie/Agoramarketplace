{
  "cleanUrls": false,
  "headers": [
    { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] }
  ],
  "rewrites": [
    { "source": "/((?!assets/|canvaskit/|icons/|\\.well-known/|.*\\.[a-z0-9]+$).*)", "destination": "/index.html" }
  ]
}
